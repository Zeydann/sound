<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_menu"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                android:tint="@color/icon" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_size" />

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_search"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                android:tint="@color/icon" />

            <ImageButton
                android:id="@+id/btn_sync"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sync"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="@color/icon" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:layout_gravity="bottom"
            android:background="@color/divider" />
    </FrameLayout>

    <EditText
        android:id="@+id/search_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/row_pad_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/row_pad_h"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="@dimen/body_size"
        android:visibility="gone" />

    <View
        android:id="@+id/search_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/divider"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:indeterminate="false"
        android:max="100"
        android:minHeight="0dp"
        android:progress="0"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="@dimen/card_min_width"
            android:horizontalSpacing="@dimen/card_gap"
            android:numColumns="2"
            android:padding="@dimen/grid_pad"
            android:scrollbarStyle="outsideOverlay"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/card_gap" />

        <LinearLayout
            android:id="@+id/status_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_size" />

            <TextView
                android:id="@+id/status_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_size" />

            <Button
                android:id="@+id/btn_status_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:background="@drawable/bg_retry"
                android:fontFamily="sans-serif-medium"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/body_size" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
