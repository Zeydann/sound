<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/row_pad_h"
    android:paddingTop="@dimen/row_pad_v"
    android:paddingEnd="@dimen/row_pad_h"
    android:paddingBottom="@dimen/row_pad_v">

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/row_name_size" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/meta_size" />
</LinearLayout>
